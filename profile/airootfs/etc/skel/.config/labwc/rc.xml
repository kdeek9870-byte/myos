<?xml version="1.0"?>
<labwc_config>
  <core><gap>5</gap></core>
  <mouse>
    <default />
    <context name="Frame">
      <mousebind button="W-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
  </mouse>
  <keyboard>
    <keybind key="W-Left">
      <action name="ToggleSnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="ToggleSnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
  </keyboard>
</labwc_config>
